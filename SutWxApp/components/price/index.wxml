<view class="{{priceClass}}">
  <text wx:if="{{showSymbol}}" class="s-price-symbol">{{symbol}}</text>
  <text class="s-price-integer">{{integerPart}}</text>
  <text wx:if="{{decimalPart}}" class="s-price-decimal">.{{decimalPart}}</text>
  <view wx:if="{{originalInteger}}" class="s-price-original">
    <text wx:if="{{showSymbol}}" class="s-price-original-symbol">{{symbol}}</text>
    <text class="s-price-original-integer">{{originalInteger}}</text>
    <text wx:if="{{originalDecimal}}" class="s-price-original-decimal">.{{originalDecimal}}</text>
  </view>
</view>
