/**
 * 文件名: index.wxss
 * 版本号: 3.0.0
 * 更新日期: 2026-07-06
 * 描述: ProductCard 商品卡片组件样式，参考设计系统规范
 */

.s-product-card {
  background-color: var(--background-primary);
  border-radius: var(--border-radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
}

.s-product-card:active {
  opacity: 0.9;
}

/* 纵向布局（网格） */
.s-product-card-vertical {
  display: flex;
  flex-direction: column;
}

.s-product-card-vertical .s-product-card-image-wrapper {
  position: relative;
  width: 100%;
  padding-top: 100%;
  background-color: var(--background-tertiary);
}

.s-product-card-vertical .s-product-card-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.s-product-card-vertical .s-product-card-tag {
  position: absolute;
  top: var(--spacing-sm);
  left: var(--spacing-sm);
}

.s-product-card-vertical .s-product-card-content {
  padding: var(--spacing-md);
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* 横向布局（列表） */
.s-product-card-horizontal {
  display: flex;
  padding: var(--spacing-md);
  gap: var(--spacing-md);
}

.s-product-card-horizontal .s-product-card-image-wrapper {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  background-color: var(--background-tertiary);
  border-radius: var(--border-radius-md);
  overflow: hidden;
  flex-shrink: 0;
}

.s-product-card-horizontal .s-product-card-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.s-product-card-horizontal .s-product-card-tag {
  position: absolute;
  top: var(--spacing-xs);
  left: var(--spacing-xs);
}

.s-product-card-horizontal .s-product-card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

/* 商品名称 */
.s-product-card-name {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
  color: var(--text-primary);
  line-height: var(--line-height-tight);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.s-product-card-vertical .s-product-card-name {
  min-height: 80rpx;
}

/* 商品描述 */
.s-product-card-desc {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  margin-top: var(--spacing-xs);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 底部区域 */
.s-product-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: var(--spacing-sm);
}

/* 加购按钮 */
.s-product-card-cart {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: var(--primary-color);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.s-product-card-cart:active {
  background-color: var(--primary-dark);
  transform: scale(0.95);
}

.s-product-card-cart-icon {
  color: var(--text-inverse);
  font-size: 28rpx;
  font-weight: var(--font-weight-bold);
  line-height: 1;
}

/* 销量 */
.s-product-card-sold {
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
  flex-shrink: 0;
}
