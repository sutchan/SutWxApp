 * 文件名: components/product-card/index.wxss
 * 版本号: 3.1.1
 * 更新日期: 2026-09-13
 * 描述: 商品卡片组件样式，对齐 design/spec.md v3.1.1 品牌绿策略
 */

.product-card {
  background-color: var(--background-primary);
  border-radius: var(--border-radius-md);
  overflow: hidden;
}

.product-card.vertical {
  width: 340rpx;
  display: flex;
  flex-direction: column;
}

.product-card.horizontal {
  display: flex;
  padding: 20rpx;
}

.product-image {
  background-color: var(--background-secondary);
}

.product-card.vertical .product-image {
  width: 340rpx;
  height: 340rpx;
}

.product-card.horizontal .product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--border-radius-md);
  margin-right: 20rpx;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.product-card.vertical .product-info {
  padding: 20rpx;
}

.product-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 8rpx;
}

.product-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.price-box {
  display: flex;
  align-items: baseline;
}

.product-price {
  font-size: 32rpx;
  color: var(--primary-dark);
  font-weight: bold;
}

.product-origin-price {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-decoration: line-through;
  margin-left: 8rpx;
}

.add-cart-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0;
  background-color: var(--primary-color);
  color: var(--text-inverse);
  font-size: 32rpx;
  border-radius: 50%;
  border: none;
  transition: opacity var(--transition-fast);
}

.add-cart-btn:active {
  opacity: 0.85;
}
