
.product-card {
  background-color: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.product-card.vertical {
  width: 340rpx;
  display: flex;
  flex-direction: column;
}

.product-card.horizontal {
  display: flex;
  padding: 20rpx;
}

.product-image {
  background-color: #f5f5f5;
}

.product-card.vertical .product-image {
  width: 340rpx;
  height: 340rpx;
}

.product-card.horizontal .product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.product-card.vertical .product-info {
  padding: 20rpx;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 8rpx;
}

.product-desc {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.price-box {
  display: flex;
  align-items: baseline;
}

.product-price {
  font-size: 32rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.product-origin-price {
  font-size: 24rpx;
  color: #ccc;
  text-decoration: line-through;
  margin-left: 8rpx;
}

.add-cart-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0;
  background-color: #ff6b6b;
  color: white;
  font-size: 32rpx;
  border-radius: 50%;
  border: none;
}

