<view class="{{cardClass}}" bindtap="onProductTap">
  <view class="s-product-card-image-wrapper">
    <image
      class="s-product-card-image"
      src="{{product.image}}"
      mode="aspectFill"
    />
    <view wx:if="{{showTag && product.tag}}" class="s-product-card-tag">
      <s-tag size="sm" variant="error">{{product.tag}}</s-tag>
    </view>
  </view>
  <view class="s-product-card-content">
    <view class="s-product-card-name">{{product.name}}</view>
    <view wx:if="{{product.desc}}" class="s-product-card-desc">{{product.desc}}</view>
    <view class="s-product-card-footer">
      <s-price
        value="{{product.priceText}}"
        original="{{product.originPriceText}}"
        size="sm"
      ></s-price>
      <view wx:if="{{layout === 'vertical' && showCart}}" class="s-product-card-cart" catchtap="onAddCartTap">
        <text class="s-product-card-cart-icon">+</text>
      </view>
      <view wx:if="{{layout === 'horizontal' && product.soldText}}" class="s-product-card-sold">
        {{product.soldText}}
      </view>
    </view>
  </view>
</view>
