
<view class="product-card {{layout}}" bindtap="onProductTap">
  <image class="product-image" src="{{product.image}}" mode="aspectFill"></image>
  <view class="product-info">
    <text class="product-name">{{product.name}}</text>
    <text class="product-desc" wx:if="{{product.desc}}">{{product.desc}}</text>
    <view class="product-bottom">
      <view class="price-box">
        <text class="product-price">¥{{product.priceText}}</text>
        <text class="product-origin-price" wx:if="{{product.originPrice}}">¥{{product.originPriceText}}</text>
      </view>
      <button class="add-cart-btn" catchtap="onAddCartTap">+</button>
    </view>
  </view>
</view>
