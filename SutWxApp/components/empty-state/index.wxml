  描述: EmptyState 空状态组件模板
-->

<view class="{{emptyStateClass}}" bindtap="onTap">
  <view class="s-empty-state-media">
    <image wx:if="{{image}}" class="s-empty-state-image" src="{{image}}" mode="aspectFit"></image>
  </view>
  <view class="s-empty-state-content">
    <view wx:if="{{title}}" class="s-empty-state-title">{{title}}</view>
    <view wx:if="{{description}}" class="s-empty-state-description">{{description}}</view>
    <view wx:if="{{showButton}}" class="s-empty-state-action">
      <s-button variant="{{buttonVariant}}" bind:tap="onButtonTap">{{buttonText}}</s-button>
    </view>
  </view>
</view>
