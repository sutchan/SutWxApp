{
  "name": "sut-wx-app",
  "version": "3.0.8",
  "description": "苏小糖微信小程序商城",
  "main": "app.js",
  "scripts": {
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "test": "jest",
    "test:coverage": "jest --ci --coverage",
    "check:version": "node scripts/check-version.js",
    "check:config": "node scripts/check-config.js",
    "check": "npm run check:version && npm run check:config",
    "ci": "npm run lint && npm run check && npm test",
    "deploy:preview": "node scripts/deploy.js --action=preview",
    "deploy:upload": "node scripts/deploy.js --action=upload"
  },
  "keywords": [
    "wechat",
    "miniprogram",
    "ecommerce"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "moduleFileExtensions": [
      "js",
      "json"
    ]
  }
}
