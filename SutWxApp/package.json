{
  "name": "sut-wx-app",
  "version": "3.5.3",
  "description": "苏小糖微信小程序商城",
  "main": "app.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --ci --coverage --passWithNoTests",
    "check:version": "node scripts/check-version.js",
    "check:config": "node scripts/check-config.js",
    "check:contract": "node scripts/check-contract.js",
    "check": "npm run check:version && npm run check:config && npm run check:contract",
    "ci": "npm run lint && npm run check && npm test",
    "deploy:preview": "node scripts/deploy.js --action=preview",
    "deploy:upload": "node scripts/deploy.js --action=upload"
  },
  "keywords": [
    "wechat",
    "miniprogram",
    "ecommerce"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "eslint": "^10.10.0",
    "jest": "^30.5.1"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": "..",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js",
      "<rootDir>/SutWxApp/__tests__/**/*.test.js"
    ],
    "moduleFileExtensions": [
      "js",
      "json"
    ]
  }
}