{
  "name": "sut-wx-app",
  "version": "3.5.17",
  "description": "苏小糖微信小程序商城",
  "main": "app.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:coverage": "jest --ci --coverage",
    "test:e2e": "node scripts/e2e/run-e2e.js",
    "check:version": "node scripts/check-version.js",
    "check:config": "node scripts/check-config.js",
    "check:contract": "node scripts/check-contract.js",
    "check": "npm run check:version && npm run check:config && npm run check:images && npm run check:ids && npm run check:contract && npm run check:bundle && npm run check:plugin-version && npm run check:docs",
    "ci": "npm run lint && npm run check && npm test",
    "deploy:preview": "node scripts/deploy.js --action=preview",
    "deploy:upload": "node scripts/deploy.js --action=upload",
    "check:bundle": "node scripts/check-bundle.js",
    "check:plugin-version": "node scripts/check-plugin-version.js",
    "check:docs": "node scripts/check-docs.js",
    "check:images": "node scripts/check-images.js",
    "check:ids": "node scripts/check-ids.js",
    "assets:compress": "node utils/compress-images.js"
  },
  "keywords": [
    "wechat",
    "miniprogram",
    "ecommerce"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "miniprogram-automator": "^0.13.0"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": "..",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js",
      "<rootDir>/SutWxApp/__tests__/**/*.test.js"
    ],
    "moduleFileExtensions": [
      "js",
      "json"
    ]
  }
}
