.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--background-secondary);
}

.content {
  flex: 1;
  padding: var(--spacing-md);
}

.card {
  background-color: var(--background-primary);
  border-radius: var(--border-radius-md);
  box-shadow: var(--shadow-sm);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-md);
}

.card-hover:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-sm);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-sm) var(--spacing-lg);
  border-radius: var(--border-radius-md);
  font-size: var(--font-size-md);
  font-weight: 500;
  text-align: center;
  cursor: pointer;
  transition: all var(--transition-fast);
  border: none;
  outline: none;
}

.btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-primary {
  background-color: var(--primary-color);
  color: #ffffff;
}

.btn-secondary {
  background-color: #2a9d8f;
  color: #ffffff;
}

.btn-outline {
  background-color: transparent;
  border: 2rpx solid var(--primary-color);
  color: var(--primary-color);
}

.btn-outline:active {
  background-color: var(--primary-light);
}

.btn-disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.btn-block { width: 100%; }
.btn-sm {
  padding: var(--spacing-xs) var(--spacing-md);
  font-size: var(--font-size-sm);
}
.btn-lg {
  padding: var(--spacing-md) var(--spacing-xl);
  font-size: var(--font-size-lg);
}

.list { background-color: var(--background-primary); }

.list-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md);
  border-bottom: 1rpx solid var(--border-color);
  background-color: var(--background-primary);
}

.list-item:last-child { border-bottom: none; }

.list-item:active { background-color: var(--background-tertiary); }

.input {
  width: 100%;
  padding: var(--spacing-md);
  border: 1rpx solid var(--border-color);
  border-radius: var(--border-radius-md);
  font-size: var(--font-size-md);
  background-color: var(--background-primary);
  outline: none;
}

.input:focus { border-color: var(--primary-color); }

.input-disabled {
  background-color: var(--background-tertiary);
  color: var(--text-tertiary);
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 2rpx var(--spacing-sm);
  border-radius: var(--border-radius-circle);
  font-size: var(--font-size-xs);
  color: #ffffff;
}

.badge-primary { background-color: var(--primary-color); }
.badge-success { background-color: #4CAF50; }
.badge-warning { background-color: #FF9800; }
.badge-error { background-color: #F44336; }

.badge-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--border-radius-circle);
  background-color: #F44336;
}

.badge-dot:empty { display: none; }

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--border-radius-circle);
  overflow: hidden;
  background-color: var(--background-tertiary);
}

.avatar-sm { width: 60rpx; height: 60rpx; }
.avatar-lg { width: 100rpx; height: 100rpx; }
.avatar-xl { width: 120rpx; height: 120rpx; }

.avatar-image { width: 100%; height: 100%; }

.divider {
  height: 1rpx;
  background-color: var(--border-color);
  margin: var(--spacing-md) 0;
}

.divider-dashed {
  border: none;
  border-top: 2rpx dashed var(--border-color);
  margin: var(--spacing-md) 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xxl);
}

.empty-state-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: var(--spacing-lg);
}

.empty-state-text {
  color: var(--text-tertiary);
  font-size: var(--font-size-md);
  text-align: center;
}

.empty-state-description {
  color: var(--text-secondary);
  font-size: var(--font-size-sm);
  margin-top: var(--spacing-sm);
  text-align: center;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg);
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: var(--border-radius-circle);
  animation: spin 0.8s linear infinite;
}

.loading-text {
  margin-left: var(--spacing-sm);
  color: var(--text-secondary);
  font-size: var(--font-size-sm);
}

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.tabs {
  display: flex;
  background-color: var(--background-primary);
  border-bottom: 1rpx solid var(--border-color);
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-md) 0;
  font-size: var(--font-size-md);
  color: var(--text-secondary);
  position: relative;
}

.tab.active {
  color: var(--primary-color);
  font-weight: 500;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: var(--primary-color);
  border-radius: 2rpx;
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

.popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
}

.popup-mask {
  flex: 1;
  background-color: rgba(0, 0, 0, 0.5);
}

.popup-content {
  background-color: var(--background-primary);
  border-radius: var(--border-radius-lg) var(--border-radius-lg) 0 0;
  max-height: 80vh;
  overflow-y: auto;
}

.popup-bottom { animation: slideUp 0.3s ease; }
.popup-top { animation: slideDown 0.3s ease; }
.popup-center { animation: fadeIn 0.3s ease; }

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes slideDown {
  from { transform: translateY(-100%); }
  to { transform: translateY(0); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.safe-area-top {
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}

.scroll-view { height: 100%; overflow: hidden; }
.scroll-view-x {
  overflow-x: auto;
  overflow-y: hidden;
  white-space: nowrap;
}
.scroll-view-y {
  overflow-y: auto;
  overflow-x: hidden;
}

.user-select-none {
  user-select: none;
  -webkit-user-select: none;
}

