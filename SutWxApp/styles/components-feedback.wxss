/**
 * 文件名: styles/components-feedback.wxss
 * 版本号: 3.5.3
 * 更新日期: 2026-10-14
 * 描述: 反馈与浮层组件样式：分割线、空态、加载、Tab、遮罩、底部弹窗及动画
 */

.divider {
  height: 1rpx;
  background-color: var(--border-color);
  margin: var(--spacing-md) 0;
}

.divider-dashed {
  border: none;
  border-top: 2rpx dashed var(--border-color);
  margin: var(--spacing-md) 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xxl);
}

.empty-state-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: var(--spacing-lg);
}

.empty-state-text {
  color: var(--text-tertiary);
  font-size: var(--font-size-md);
  text-align: center;
}

.empty-state-description {
  color: var(--text-secondary);
  font-size: var(--font-size-sm);
  margin-top: var(--spacing-sm);
  text-align: center;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg);
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: var(--border-radius-circle);
  animation: spin 0.8s linear infinite;
}

.loading-text {
  margin-left: var(--spacing-sm);
  color: var(--text-secondary);
  font-size: var(--font-size-sm);
}

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.tabs {
  display: flex;
  background-color: var(--background-primary);
  border-bottom: 1rpx solid var(--border-color);
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-md) 0;
  font-size: var(--font-size-md);
  color: var(--text-secondary);
  position: relative;
}

.tab.active {
  color: var(--primary-color);
  font-weight: 500;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: var(--primary-color);
  border-radius: 2rpx;
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

.popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
}

.popup-mask {
  flex: 1;
  background-color: rgba(0, 0, 0, 0.5);
}

.popup-content {
  background-color: var(--background-primary);
  border-radius: var(--border-radius-lg) var(--border-radius-lg) 0 0;
  max-height: 80vh;
  overflow-y: auto;
}

.popup-bottom {
  animation: slideUp 0.3s ease;
}

.popup-top {
  animation: slideDown 0.3s ease;
}

.popup-center {
  animation: fadeIn 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }

  to {
    transform: translateY(0);
  }
}

@keyframes slideDown {
  from {
    transform: translateY(-100%);
  }

  to {
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}
