/**
 * 文件名: styles/layout-visual.wxss
 * 版本号: 3.5.3
 * 更新日期: 2026-10-14
 * 描述: 安全区、滚动容器、层级、显隐与透明度工具类
 */

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.safe-area-top {
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}

.scroll-view {
  height: 100%;
  overflow: hidden;
}

.scroll-view-x {
  overflow-x: auto;
  overflow-y: hidden;
  white-space: nowrap;
}

.scroll-view-y {
  overflow-y: auto;
  overflow-x: hidden;
}

.user-select-none {
  user-select: none;
  -webkit-user-select: none;
}

.z-index-1 {
  z-index: 1;
}

.z-index-10 {
  z-index: 10;
}

.z-index-100 {
  z-index: 100;
}

.z-index-1000 {
  z-index: 1000;
}

.z-index-9999 {
  z-index: 9999;
}

.visible {
  visibility: visible;
}

.invisible {
  visibility: hidden;
}

.hidden {
  display: none;
}

.opacity-0 {
  opacity: 0;
}

.opacity-25 {
  opacity: 0.25;
}

.opacity-50 {
  opacity: 0.5;
}

.opacity-75 {
  opacity: 0.75;
}

.opacity-100 {
  opacity: 1;
}
