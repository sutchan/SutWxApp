/**
 * 文件名: pages/user/index.wxss
 * 版本号: 3.1.1
 * 更新日期: 2026-09-13
 * 描述: 用户中心页面样式，对齐 design/spec.md v3.1.1 品牌绿头部渐变
 */

page {
  background-color: var(--background-secondary);
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.header-section {
  background: linear-gradient(135deg, var(--grad-user-header));
  padding: 40rpx 30rpx 100rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  background-color: var(--background-primary);
}

.avatar.placeholder {
  opacity: 0.8;
}

.info-content {
  flex: 1;
  margin-left: 24rpx;
}

.nickname {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-inverse);
  margin-bottom: 8rpx;
}

.user-id {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.arrow-right {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.6;
}

.login-prompt {
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-text {
  margin-left: 20rpx;
  font-size: 32rpx;
  color: var(--text-inverse);
}

.stats-section {
  display: flex;
  align-items: center;
  background-color: var(--background-primary);
  margin: -60rpx 30rpx 20rpx;
  border-radius: var(--border-radius-lg);
  padding: 40rpx 0;
  box-shadow: var(--shadow-md);
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-value {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.stats-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: var(--border-color);
}

.menu-section {
  flex: 1;
  padding: 0 30rpx;
}

.menu-group {
  background-color: var(--background-primary);
  border-radius: var(--border-radius-lg);
  margin-bottom: 20rpx;
  overflow: hidden;
}

.menu-group-header {
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.menu-group-name {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.menu-group-content {
  padding: 10rpx 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 24rpx;
}

.menu-name {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
}

.menu-arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.4;
}

.logout-section {
  padding: 40rpx 30rpx;
}

.logout-btn {
  background-color: var(--background-primary);
  border-radius: var(--border-radius-lg);
  padding: 28rpx 0;
  text-align: center;
  font-size: 32rpx;
  color: var(--error-color);
  font-weight: bold;
}

.logout-btn:active {
  background-color: var(--error-light);
}

.version-info {
  padding: 40rpx 0;
  text-align: center;
}

.version-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}
