.privacy-page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  background: #f6f7f9;
  box-sizing: border-box;
}

.privacy-card {
  padding: 40rpx 32rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.privacy-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2329;
  text-align: center;
}

.privacy-desc {
  margin-top: 28rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #4e5969;
}

.privacy-contract {
  margin-top: 28rpx;
}

.contract-link {
  font-size: 28rpx;
  color: #ff4d4f;
}

.privacy-tip {
  margin-top: 24rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #fff7e8;
  font-size: 24rpx;
  color: #a8700a;
}

.privacy-actions {
  display: flex;
  margin-top: 48rpx;
}

.privacy-btn {
  flex: 1;
  margin: 0 12rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  height: 80rpx;
}

.privacy-btn::after {
  border: none;
}

.privacy-btn-reject {
  background: #f2f3f5;
  color: #4e5969;
}

.privacy-btn-agree {
  background: #ff4d4f;
  color: #fff;
}

.privacy-setting {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #86909c;
  text-align: center;
}
