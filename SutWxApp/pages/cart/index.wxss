 * 描述: 购物车页面样式 - Apple极简风格
 */

.cart-container {
  min-height: 100vh;
  background-color: var(--background-secondary);
  padding-bottom: 140rpx;
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
  margin-bottom: 40rpx;
}

.go-shopping-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  background-color: var(--primary-color);
  color: var(--text-inverse);
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
}

.cart-list {
  padding: 20rpx;
}

.cart-item {
  display: flex;
  align-items: flex-start;
  background-color: var(--background-primary);
  border-radius: var(--border-radius-lg);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
  transition: box-shadow var(--transition-fast);
}

.cart-item:active {
  box-shadow: var(--shadow-md);
}

.select-box {
  padding: 10rpx;
}

.select-icon {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--background-primary);
  transition: all var(--transition-fast);
}

.select-icon.selected {
  border-color: var(--primary-color);
  background-color: var(--primary-color);
}

.select-icon .icon {
  color: var(--text-inverse);
  font-size: 24rpx;
  font-weight: bold;
}

.product-image {
  width: 176rpx;
  height: 176rpx;
  border-radius: var(--border-radius-md);
  margin-right: 20rpx;
  background-color: var(--background-tertiary);
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.product-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-spec {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 20rpx;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-price {
  font-size: 32rpx;
  color: var(--primary-dark);
  font-weight: 700;
}

.quantity-box {
  display: flex;
  align-items: center;
  background-color: var(--background-tertiary);
  border-radius: 8rpx;
  padding: 4rpx;
}

.quantity-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-secondary);
  transition: all var(--transition-fast);
}

.quantity-btn:active {
  background-color: var(--border-color);
  color: var(--text-primary);
}

.quantity-text {
  width: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.delete-btn {
  padding: 10rpx 20rpx;
}

.delete-text {
  font-size: 24rpx;
  color: var(--error-color);
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background-color: var(--background-primary);
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.select-all-box {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}

.select-all-text {
  font-size: 26rpx;
  color: var(--text-primary);
  margin-left: 10rpx;
  font-weight: 500;
}

.total-box {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.total-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 400;
}

.total-price {
  font-size: 36rpx;
  color: var(--primary-dark);
  font-weight: 700;
  margin-left: 10rpx;
}

.checkout-btn {
  width: 200rpx;
  height: 80rpx;
  line-height: 80rpx;
  background-color: var(--primary-color);
  color: var(--text-inverse);
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  margin-left: 20rpx;
}

.checkout-btn[disabled] {
  background-color: var(--border-color);
}