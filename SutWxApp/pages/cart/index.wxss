.cart-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.go-shopping-btn {
  width: 200rpx;
  height: 70rpx;
  line-height: 70rpx;
  background-color: #ff6b6b;
  color: white;
  font-size: 28rpx;
  border-radius: 35rpx;
}

/* 商品列表 */
.cart-list {
  padding: 20rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  background-color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.select-box {
  padding: 10rpx;
}

.select-icon {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: white;
}

.select-icon.selected {
  border-color: #ff6b6b;
  background-color: #ff6b6b;
}

.select-icon .icon {
  color: white;
  font-size: 24rpx;
  font-weight: bold;
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-spec {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-price {
  font-size: 32rpx;
  color: #ff6b6b;
  font-weight: bold;
}

.quantity-box {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

.quantity-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666;
}

.quantity-text {
  width: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
}

.delete-btn {
  padding: 10rpx 20rpx;
}

.delete-text {
  font-size: 24rpx;
  color: #ff6b6b;
}

/* 底部栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background-color: white;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.select-all-box {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}

.select-all-text {
  font-size: 26rpx;
  color: #333;
  margin-left: 10rpx;
}

.total-box {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.total-label {
  font-size: 26rpx;
  color: #333;
}

.total-price {
  font-size: 36rpx;
  color: #ff6b6b;
  font-weight: bold;
  margin-left: 10rpx;
}

.checkout-btn {
  width: 200rpx;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #ff6b6b;
  color: white;
  font-size: 28rpx;
  border-radius: 40rpx;
  margin-left: 20rpx;
  padding: 0;
  border: none;
}

.checkout-btn[disabled] {
  background-color: #ddd;
}

