
<!--
文件名: index.wxml
版本号: 2.1.0
更新日期: 2026-06-09
描述: 购物车页面模板，展示购物车商品列表
-->
<view class="cart-container">
  <!-- 空状态 -->
  <view wx:if="{{empty}}" class="empty-container">
    <image class="empty-icon" src="/images/placeholder.svg" mode="aspectFit"></image>
    <text class="empty-text">购物车空空如也</text>
    <button class="go-shopping-btn" bindtap="onGoShopping">去逛逛</button>
  </view>

  <!-- 商品列表 -->
  <view wx:else class="cart-list">
    <view wx:for="{{cartList}}" wx:key="id" class="cart-item">
      <!-- 选择按钮 -->
      <view class="select-box" bindtap="onSelectItem" data-index="{{index}}">
        <view class="select-icon {{item.selected ? 'selected' : ''}}">
          <text wx:if="{{item.selected}}" class="icon">✓</text>
        </view>
      </view>

      <!-- 商品图片 -->
      <image class="product-image" src="{{item.image}}" mode="aspectFill"></image>

      <!-- 商品信息 -->
      <view class="product-info">
        <text class="product-name">{{item.name}}</text>
        <text class="product-spec" wx:if="{{item.spec}}">{{item.spec}}</text>

        <view class="product-bottom">
          <text class="product-price">{{item.priceText}}</text>

          <view class="quantity-box">
            <view class="quantity-btn" bindtap="onDecreaseQuantity" data-index="{{index}}">-</view>
            <text class="quantity-text">{{item.quantity}}</text>
            <view class="quantity-btn" bindtap="onIncreaseQuantity" data-index="{{index}}">+</view>
          </view>
        </view>
      </view>

      <!-- 删除按钮 -->
      <view class="delete-btn" bindtap="onDeleteItem" data-index="{{index}}">
        <text class="delete-text">删除</text>
      </view>
    </view>
  </view>

  <!-- 底部栏 -->
  <view wx:if="{{!empty}}" class="bottom-bar">
    <!-- 全选 -->
    <view class="select-all-box" bindtap="onSelectAll">
      <view class="select-icon {{selectAll ? 'selected' : ''}}">
        <text wx:if="{{selectAll}}" class="icon">✓</text>
      </view>
      <text class="select-all-text">全选</text>
    </view>

    <!-- 合计 -->
    <view class="total-box">
      <text class="total-label">合计：</text>
      <text class="total-price">{{totalPriceText}}</text>
    </view>

    <!-- 结算按钮 -->
    <button class="checkout-btn" bindtap="onCheckout" disabled="{{totalCount === 0}}">
      结算({{totalCount}})
    </button>
  </view>
</view>
