 */

.quantity-box {
  display: flex;
  align-items: center;
  background-color: var(--background-tertiary);
  border-radius: 8rpx;
  padding: 4rpx;
}

.quantity-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-secondary);
  transition: all var(--transition-fast);
}

.quantity-btn:active {
  background-color: var(--border-color);
  color: var(--text-primary);
}

.quantity-text {
  width: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.delete-btn {
  padding: 10rpx 20rpx;
}

.delete-text {
  font-size: 24rpx;
  color: var(--error-color);
}
