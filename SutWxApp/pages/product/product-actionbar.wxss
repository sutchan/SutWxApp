 * 更新日期: 2026-10-14
 * 描述: 底部操作栏：客服/收藏/购物车图标与加购、立即购买按钮
 */

.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  height: 100rpx;
  background-color: var(--background-primary);
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.action-icons {
  display: flex;
  flex: 1;
  padding: 0 20rpx;
}

.icon-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.icon-item image {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 4rpx;
}

.icon-item text {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.cart-badge {
  position: absolute;
  top: 6rpx;
  right: 10rpx;
  min-width: 32rpx;
  height: 32rpx;
  background-color: var(--primary-color);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.cart-badge text {
  font-size: 20rpx;
  color: var(--text-inverse);
}

.action-buttons {
  display: flex;
  flex: 1;
}

.btn-add-cart,
.btn-buy-now {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  transition: opacity var(--transition-fast);
}

.btn-add-cart:active,
.btn-buy-now:active {
  opacity: 0.85;
}

.btn-add-cart {
  background-color: var(--primary-dark);
  color: var(--text-inverse);
}

.btn-buy-now {
  background-color: var(--primary-color);
  color: var(--text-inverse);
}
