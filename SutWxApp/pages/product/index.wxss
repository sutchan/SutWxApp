/**
 * 文件名: index.wxss
 * 版本号: 3.0.0
 * 更新日期: 2026-07-06
 * 描述: 产品详情页样式表
 */

page {
  background-color: var(--background-secondary);
  padding-bottom: 60px;
}

.loading-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-4xl) 0;
  font-size: var(--font-size-md);
  color: var(--text-tertiary);
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.product-image-section {
  position: relative;
  width: 100%;
  height: 375px;
  background-color: var(--background-primary);
}

.product-image-swiper {
  width: 100%;
  height: 100%;
}

.product-image {
  width: 100%;
  height: 100%;
}

.image-indicator {
  position: absolute;
  bottom: var(--spacing-lg);
  right: var(--spacing-lg);
  background-color: rgba(0, 0, 0, 0.5);
  padding: var(--spacing-xs) var(--spacing-md);
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  color: var(--text-inverse);
}

.product-actions-overlay {
  position: absolute;
  top: var(--spacing-lg);
  right: var(--spacing-lg);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.action-btn {
  width: 35px;
  height: 35px;
  background-color: rgba(0, 0, 0, 0.4);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn image {
  width: 20px;
  height: 20px;
}

.product-info-section {
  background-color: var(--background-primary);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-sm);
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: var(--spacing-md);
}

.price-info {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.sales-info {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}

.product-name {
  font-size: var(--font-size-xl);
  color: var(--text-primary);
  font-weight: var(--font-weight-bold);
  line-height: var(--line-height-tight);
  margin-bottom: var(--spacing-sm);
}

.product-desc {
  font-size: var(--font-size-md);
  color: var(--text-secondary);
  line-height: var(--line-height-relaxed);
  margin-bottom: var(--spacing-md);
}

.product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.spec-section {
  display: flex;
  align-items: center;
  background-color: var(--background-primary);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-sm);
}

.spec-label {
  font-size: var(--font-size-md);
  color: var(--text-secondary);
  margin-right: var(--spacing-lg);
}

.spec-content {
  flex: 1;
}

.spec-text {
  font-size: var(--font-size-md);
  color: var(--text-primary);
}

.arrow-icon {
  width: 8px;
  height: 14px;
}

.service-section {
  display: flex;
  justify-content: space-around;
  background-color: var(--background-primary);
  padding: var(--spacing-md) var(--spacing-lg);
  margin-bottom: var(--spacing-sm);
}

.service-item {
  display: flex;
  align-items: center;
}

.service-item image {
  width: 14px;
  height: 14px;
  margin-right: var(--spacing-xs);
}

.service-item text {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}

.reviews-section {
  background-color: var(--background-primary);
  margin-bottom: var(--spacing-sm);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-lg);
  border-bottom: 1px solid var(--border-light);
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--text-primary);
}

.view-all {
  display: flex;
  align-items: center;
}

.view-all text {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
}

.view-all image {
  width: 8px;
  height: 14px;
  margin-left: var(--spacing-xs);
}

.review-list {
  padding: 0 var(--spacing-lg);
}

.review-item {
  padding: var(--spacing-md) 0;
  border-bottom: 1px solid var(--border-light);
}

.review-item:last-child {
  border-bottom: none;
}

.review-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-sm);
  gap: var(--spacing-sm);
}

.review-username {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  margin-right: var(--spacing-sm);
}

.review-rating {
  display: flex;
}

.star-icon {
  width: 12px;
  height: 12px;
  margin-right: 2px;
}

.review-content {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  line-height: var(--line-height-normal);
  margin-bottom: var(--spacing-sm);
}

.review-spec {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  margin-bottom: var(--spacing-xs);
}

.review-time {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
}

.load-more {
  text-align: center;
  padding: var(--spacing-lg);
}

.load-more text {
  font-size: var(--font-size-md);
  color: var(--primary-color);
}

.product-detail-section {
  background-color: var(--background-primary);
  margin-bottom: var(--spacing-sm);
}

.detail-content {
  padding: var(--spacing-lg);
}

.detail-content image {
  max-width: 100%;
}

.params-section {
  padding: 0 var(--spacing-lg) var(--spacing-lg);
}

.params-title {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--text-primary);
  margin-bottom: var(--spacing-md);
}

.params-list {
  display: flex;
  flex-wrap: wrap;
}

.params-item {
  width: 50%;
  display: flex;
  padding: var(--spacing-sm) 0;
}

.params-name {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  width: 80px;
}

.params-value {
  font-size: var(--font-size-sm);
  color: var(--text-primary);
  flex: 1;
}

.related-section {
  background-color: var(--background-primary);
}

.related-list {
  display: flex;
  flex-wrap: wrap;
  padding: var(--spacing-md);
  gap: var(--spacing-md);
}

.related-item {
  width: calc(33.33% - 16px);
}

.related-image {
  width: 100%;
  height: 110px;
  border-radius: var(--border-radius-md);
  background-color: var(--background-tertiary);
}

.related-info {
  padding: var(--spacing-sm) 0;
}

.related-name {
  font-size: var(--font-size-sm);
  color: var(--text-primary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: var(--spacing-xs);
  line-height: var(--line-height-tight);
}

.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  height: 50px;
  background-color: var(--background-primary);
  box-shadow: 0 -1px 4px rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.action-icons {
  display: flex;
  flex: 1;
  padding: 0 var(--spacing-md);
}

.icon-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.icon-item image {
  width: 22px;
  height: 22px;
  margin-bottom: 2px;
}

.icon-item text {
  font-size: var(--font-size-xs);
  color: var(--text-secondary);
}

.s-badge {
  position: absolute;
  top: 2px;
  right: 10px;
}

.action-buttons {
  display: flex;
  flex: 1;
  gap: var(--spacing-xs);
  padding: var(--spacing-xs) 0;
  padding-right: var(--spacing-md);
}

.action-buttons .s-button {
  flex: 1;
}

.spec-popup-mask,
.review-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 200;
}

.spec-popup,
.review-popup {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: var(--background-primary);
  border-radius: var(--border-radius-xl) var(--border-radius-xl) 0 0;
  z-index: 201;
  transform: translateY(100%);
  transition: transform var(--transition-normal);
}

.spec-popup.show,
.review-popup.show {
  transform: translateY(0);
}

.spec-popup-header,
.review-popup-header {
  display: flex;
  align-items: flex-end;
  padding: var(--spacing-lg);
  border-bottom: 1px solid var(--border-light);
  position: relative;
}

.spec-popup-image {
  width: 90px;
  height: 90px;
  border-radius: var(--border-radius-md);
  background-color: var(--background-tertiary);
}

.spec-popup-info {
  flex: 1;
  margin-left: var(--spacing-md);
}

.spec-popup-price {
  margin-bottom: var(--spacing-xs);
}

.spec-popup-stock {
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  margin-bottom: var(--spacing-xs);
}

.spec-popup-selected {
  font-size: var(--font-size-sm);
  color: var(--text-primary);
}

.spec-popup-close,
.review-popup-close {
  position: absolute;
  top: var(--spacing-lg);
  right: var(--spacing-lg);
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.spec-popup-close image,
.review-popup-close image {
  width: 16px;
  height: 16px;
}

.spec-popup-body,
.review-popup-body {
  max-height: 60vh;
  padding-bottom: 120px;
}

.spec-section {
  padding: var(--spacing-lg);
}

.spec-title {
  font-size: var(--font-size-md);
  color: var(--text-secondary);
  margin-bottom: var(--spacing-md);
}

.spec-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-md);
}

.spec-item {
  padding: var(--spacing-sm) var(--spacing-lg);
  background-color: var(--background-tertiary);
  border-radius: var(--border-radius-sm);
  font-size: var(--font-size-md);
  color: var(--text-primary);
  transition: all var(--transition-fast);
}

.spec-item.active {
  background-color: var(--primary-color);
  color: var(--text-inverse);
}

.quantity-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-lg);
  border-top: 1px solid var(--border-light);
}

.quantity-title {
  font-size: var(--font-size-md);
  color: var(--text-secondary);
}

.quantity-selector {
  display: flex;
  align-items: center;
}

.quantity-btn {
  width: 28px;
  height: 28px;
  background-color: var(--background-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-lg);
  color: var(--text-primary);
}

.quantity-btn:first-child {
  border-radius: var(--border-radius-sm) 0 0 var(--border-radius-sm);
}

.quantity-btn:last-child {
  border-radius: 0 var(--border-radius-sm) var(--border-radius-sm) 0;
}

.quantity-btn.disabled {
  opacity: 0.5;
}

.quantity-input {
  width: 40px;
  height: 28px;
  text-align: center;
  font-size: var(--font-size-md);
  color: var(--text-primary);
  background-color: var(--background-tertiary);
}

.spec-popup-footer {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--spacing-md) var(--spacing-lg);
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  background-color: var(--background-primary);
  border-top: 1px solid var(--border-light);
}

.review-popup-header {
  justify-content: center;
}

.review-popup-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--text-primary);
}

.review-popup-body {
  padding: 0 var(--spacing-lg);
}

.review-list-full {
  padding: var(--spacing-md) 0;
}
