
/**
 * 文件名: pages/category/index.wxss
 * 版本号: 3.1.1
 * 更新日期: 2026-09-13
 * 描述: 分类页面样式，对齐 design/spec.md v3.1.1 品牌绿策略
 */

.category-container {
  display: flex;
  height: 100vh;
  background-color: var(--background-secondary);
}

/* 分类侧边栏 */
.category-sidebar {
  width: 180rpx;
  background-color: var(--background-secondary);
}

.category-item {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  position: relative;
  transition: background-color var(--transition-fast), color var(--transition-fast);
}

.category-item.active {
  background-color: var(--background-primary);
  color: var(--primary-color);
  font-weight: 500;
}

.category-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background-color: var(--primary-color);
  border-radius: 0 4rpx 4rpx 0;
}

/* 商品区域 */
.product-area {
  flex: 1;
  background-color: var(--background-primary);
}

.product-list {
  padding: 20rpx;
}

.product-card {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--border-radius-md);
  margin-right: 20rpx;
  background-color: var(--background-secondary);
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-price {
  font-size: 32rpx;
  color: var(--primary-dark);
  font-weight: bold;
}

.add-cart-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0;
  background-color: var(--primary-color);
  color: var(--text-inverse);
  font-size: 32rpx;
  border-radius: 50%;
  border: none;
  transition: opacity var(--transition-fast);
}

.add-cart-btn:active {
  opacity: 0.85;
}

/* 空状态 */
.empty-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}
