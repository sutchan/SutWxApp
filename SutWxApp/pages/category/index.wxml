描述: 分类页面模板
-->
<view class="category-container">
  <!-- 分类列表 -->
  <scroll-view class="category-sidebar" scroll-y>
    <view
      wx:for="{{categoryList}}"
      wx:key="id"
      class="category-item {{activeCategoryIndex === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="onCategoryChange"
    >
      <text>{{item.name}}</text>
    </view>
  </scroll-view>

  <!-- 商品列表 -->
  <scroll-view class="product-area" scroll-y>
    <view class="product-list">
      <view
        wx:for="{{productList}}"
        wx:key="id"
        class="product-card"
        data-id="{{item.id}}"
        bindtap="onViewProduct"
      >
        <image class="product-image" src="{{item.image}}" mode="aspectFill"></image>
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text class="product-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
          <view class="product-bottom">
            <text class="product-price">¥{{item.priceText}}</text>
            <button class="add-cart-btn" catchtap="onAddToCart" data-id="{{item.id}}">+</button>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{productList.length === 0 && !loading}}" class="empty-container">
      <text class="empty-text">暂无商品</text>
    </view>
  </scroll-view>
</view>
