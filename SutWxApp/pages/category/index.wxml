  描述: 分类页面模板
-->
<view class="category-container">
  <!-- 分类列表 -->
  <scroll-view class="category-sidebar" scroll-y>
    <view
      wx:for="{{categoryList}}"
      wx:key="id"
      class="category-item {{activeCategoryIndex === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="onCategoryChange"
    >
      <text>{{item.name}}</text>
    </view>
  </scroll-view>

  <!-- 商品列表 -->
  <scroll-view class="product-area" scroll-y>
    <view class="product-list" wx:if="{{productList.length > 0}}">
      <s-product-card
        wx:for="{{productList}}"
        wx:key="id"
        product="{{item}}"
        layout="horizontal"
        showCart="{{true}}"
        showTag="{{false}}"
        bind:productTap="onViewProduct"
        bind:addCartTap="onAddToCart"
      ></s-product-card>
    </view>

    <!-- 空状态 -->
    <s-empty-state
      wx:if="{{productList.length === 0 && !loading}}"
      title="暂无商品"
      description="该分类下暂无商品"
    ></s-empty-state>
  </scroll-view>
</view>
