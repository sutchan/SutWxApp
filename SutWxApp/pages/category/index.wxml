
<!--
文件名: index.wxml
版本号: 3.0.13
更新日期: 2026-07-01
描述: 分类页面模板
-->
<view class="category-container" id="page-root" style="{{themeStyle}}">
  <!-- 分类侧边栏（包含“热门分类”等分组头） -->
  <scroll-view class="category-sidebar" scroll-y id="category-sidebar">
    <block wx:for="{{categoryGroups}}" wx:key="title" wx:for-item="group" wx:for-index="gIdx">
      <view class="category-group-header" id="cat-group-header-{{gIdx}}" wx:if="{{group.title}}">{{group.title}}</view>
      <view
        wx:for="{{group.items}}"
        wx:key="id"
        class="category-item {{activeCategoryId === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onCategoryChange"
        id="cat-item-{{item.id}}"
      >
        <text>{{item.name}}</text>
      </view>
    </block>
  </scroll-view>

  <!-- 商品列表区域（带微淡入动效） -->
  <scroll-view class="product-area {{fadeIn ? 'fade-in' : ''}}" scroll-y id="category-product-area">
    <view class="product-list" id="category-product-list">
      <view
        wx:for="{{productList}}"
        wx:key="id"
        class="product-card"
        data-id="{{item.id}}"
        bindtap="onViewProduct"
      >
        <image class="product-image" src="{{item.image}}" mode="aspectFill"></image>
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text class="product-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
          <view class="product-bottom">
            <text class="product-price">¥{{item.priceText}}</text>
            <button class="add-cart-btn">+</button>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{productList.length === 0 && !loading}}" class="empty-container">
      <text class="empty-text">暂无商品</text>
    </view>
  </scroll-view>
</view>

