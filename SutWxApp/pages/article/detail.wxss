.article-detail {
  min-height: 100vh;
  background: #fff;
  padding: 32rpx;
  box-sizing: border-box;
}

.article-header {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.article-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.4;
}

.article-date {
  font-size: 24rpx;
  color: #b0b0b0;
  margin-top: 16rpx;
}

.article-cover {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  background: #f1f8e9;
  margin-bottom: 24rpx;
}

.article-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
}

.article-content image {
  max-width: 100%;
  border-radius: 12rpx;
  margin: 16rpx 0;
}

.loading {
  text-align: center;
  color: #86868b;
  font-size: 26rpx;
  padding: 60rpx 0;
}
