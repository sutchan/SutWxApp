@import "./help-search.wxss";
@import "./help-category.wxss";
@import "./help-faq.wxss";
@import "./help-feedback.wxss";

.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

.header {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  padding: 60rpx 40rpx 80rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}
