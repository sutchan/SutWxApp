.feedback-section {
  margin: 30rpx;
}

.feedback-btn {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  border-radius: 16rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
}

.feedback-btn text:first-child {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.feedback-hint {
  font-size: 24rpx;
  opacity: 0.85;
}

.article-entry {
  margin: 30rpx;
  background: #f1f8e9;
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
}

.article-entry-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.article-entry-texts {
  display: flex;
  flex-direction: column;
}

.article-entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1b5e20;
}

.article-entry-hint {
  font-size: 24rpx;
  color: #2e7d32;
  margin-top: 6rpx;
}
