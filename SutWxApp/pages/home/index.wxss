/**
 * 文件名: index.wxss
 * 版本号: 3.0.0
 * 更新日期: 2026-07-01
 * 描述: 首页样式表 - Apple极简风格
 */

page {
  background-color: var(--background-secondary);
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: var(--background-primary);
  padding: 20rpx 30rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 72rpx;
  background-color: var(--background-tertiary);
  border-radius: 36rpx;
  padding: 0 30rpx;
  transition: background-color var(--transition-fast);
}

.search-bar:active {
  background-color: var(--border-color);
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-placeholder {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 300;
}

.banner-section {
  margin-top: 112rpx;
  padding: 0 30rpx;
}

.banner-swiper {
  width: 100%;
  height: 360rpx;
  background-color: var(--background-primary);
  border-radius: var(--border-radius-lg);
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.category-section {
  background-color: var(--background-primary);
  padding: 24rpx 0;
  margin: 20rpx 0;
}

.category-scroll {
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  padding: 0 30rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 40rpx;
  padding: 10rpx;
  border-radius: var(--border-radius-md);
  transition: background-color var(--transition-fast);
}

.category-item:last-child {
  margin-right: 0;
}

.category-item:active {
  background-color: var(--background-tertiary);
}

.category-icon {
  width: 88rpx;
  height: 88rpx;
  background-color: var(--primary-light);
  border-radius: var(--border-radius-lg);
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-name {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.product-section {
  background-color: var(--background-secondary);
  padding: 0 30rpx 30rpx;
  flex: 1;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: -0.01em;
}

.more-link {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.more-link::after {
  content: '›';
  font-size: 32rpx;
  margin-left: 8rpx;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.product-grid.fade-in {
  animation: wxSubtleFadeIn 0.32s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes wxSubtleFadeIn {
  0% {
    opacity: 0;
    transform: translateY(10rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.product-card {
  background-color: var(--background-primary);
  border-radius: var(--border-radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: box-shadow var(--transition-fast), transform var(--transition-fast);
}

.product-card:active {
  box-shadow: var(--shadow-md);
  transform: scale(0.98);
}

.product-image-wrapper {
  position: relative;
}

.product-image {
  width: 100%;
  height: 340rpx;
  background-color: var(--background-tertiary);
}

.product-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 4rpx 16rpx;
  background-color: var(--primary-color);
  color: var(--text-inverse);
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 20rpx;
}

.product-info {
  padding: 20rpx;
}

.product-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.product-price {
  font-size: 34rpx;
  color: var(--primary-dark);
  font-weight: 700;
  letter-spacing: -0.02em;
}

.product-price::before {
  content: '¥';
  font-size: 24rpx;
  font-weight: 400;
}

.product-original-price {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-decoration: line-through;
}

.product-sales {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.loading-tip {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

/* 搜索历史浮层与遮罩 */
.search-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(4px);
  z-index: 150;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--transition-normal);
}

.search-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.search-history-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: var(--background-primary);
  border-radius: 0 0 32rpx 32rpx;
  box-shadow: var(--shadow-lg);
  z-index: 160;
  transform: translateY(-105%);
  transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  padding-bottom: 30rpx;
}

.search-history-layer.show {
  transform: translateY(0);
}

.sh-layer-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.sh-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  background-color: var(--background-secondary);
  border-radius: 36rpx;
  padding: 0 24rpx;
}

.sh-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.sh-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.sh-clear-input {
  font-size: 26rpx;
  color: var(--text-tertiary);
  padding: 6rpx 10rpx;
}

.sh-cancel-btn {
  font-size: 28rpx;
  color: var(--text-secondary);
  padding: 10rpx 4rpx;
}

.sh-layer-body {
  padding: 24rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.sh-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.sh-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sh-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.sh-clear-action {
  font-size: 24rpx;
  color: var(--text-tertiary);
  padding: 4rpx 10rpx;
}

.sh-tags-box {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sh-tag-item {
  display: inline-flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-primary);
  background-color: var(--background-secondary);
  border: 1rpx solid var(--border-color);
  padding: 10rpx 26rpx;
  border-radius: 28rpx;
  transition: all var(--transition-fast);
}

.sh-tag-item:active {
  transform: scale(0.96);
  background-color: var(--primary-light);
  color: var(--primary-color);
}

.sh-tag-item.hot {
  background-color: var(--background-tertiary);
}

.sh-empty-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  padding: 10rpx 0;
}

/* 搜索建议与加载动效追加 */
.sh-loading-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(46, 125, 50, 0.2);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  margin-right: 12rpx;
  animation: spin-anim 0.8s linear infinite;
  flex-shrink: 0;
}
@keyframes spin-anim {
  100% { transform: rotate(360deg); }
}

.sh-suggestions-list {
  display: flex;
  flex-direction: column;
}

.sh-suggestion-item {
  display: flex;
  align-items: center;
  padding: 22rpx 10rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.sh-suggestion-item:active {
  background-color: var(--primary-light);
}

.sh-sug-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 16rpx;
  opacity: 0.4;
}

.sh-sug-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}