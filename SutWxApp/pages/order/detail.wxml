
<!--
文件名: detail.wxml
版本号: 3.0.0
更新日期: 2026-07-06
描述: 订单详情页面模板
-->
<!-- 加载中 -->
<view wx:if="{{loading}}" class="loading">
  <view class="loading-spinner"></view>
  <text class="loading-text">加载中...</text>
</view>

<!-- 加载失败/空状态 -->
<s-empty-state
  wx:elif="{{!orderDetail}}"
  image="/images/placeholder.svg"
  title="订单信息加载失败"
  description="请稍后重试"
/>

<!-- 订单详情 -->
<view wx:else class="detail-container">
  <!-- 订单状态 -->
  <view class="status-section">
    <text class="status-text">{{orderDetail.statusText}}</text>
    <text class="status-desc" wx:if="{{orderDetail.statusDesc}}">{{orderDetail.statusDesc}}</text>
  </view>

  <!-- 收货地址 -->
  <view class="address-section">
    <view class="address-info">
      <text class="name-phone">{{orderDetail.address.name}} {{orderDetail.address.phone}}</text>
      <text class="address-detail">{{orderDetail.address.detail}}</text>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="products-section">
    <view
      wx:for="{{orderDetail.products}}"
      wx:key="id"
      class="product-item"
    >
      <image class="product-image" src="{{item.image}}" mode="aspectFill"></image>
      <view class="product-info">
        <text class="product-name">{{item.name}}</text>
        <text class="product-spec" wx:if="{{item.spec}}">{{item.spec}}</text>
        <view class="product-bottom">
          <s-price value="{{item.priceText}}" size="sm"></s-price>
          <text class="product-quantity">x{{item.quantity}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="info-section">
    <view class="info-item">
      <text class="info-label">订单编号</text>
      <text class="info-value">{{orderDetail.orderNo}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">下单时间</text>
      <text class="info-value">{{orderDetail.createTime}}</text>
    </view>
    <view class="info-item" wx:if="{{orderDetail.payTime}}">
      <text class="info-label">支付时间</text>
      <text class="info-value">{{orderDetail.payTime}}</text>
    </view>
    <view class="info-item" wx:if="{{orderDetail.deliveryTime}}">
      <text class="info-label">发货时间</text>
      <text class="info-value">{{orderDetail.deliveryTime}}</text>
    </view>
    <view class="info-item" wx:if="{{orderDetail.completeTime}}">
      <text class="info-label">完成时间</text>
      <text class="info-value">{{orderDetail.completeTime}}</text>
    </view>
  </view>

  <!-- 价格信息 -->
  <view class="price-section">
    <view class="price-item">
      <text class="price-label">商品金额</text>
      <s-price value="{{orderDetail.productPriceText}}" size="sm" color="text"></s-price>
    </view>
    <view class="price-item">
      <text class="price-label">运费</text>
      <s-price value="{{orderDetail.shippingFeeText}}" size="sm" color="text"></s-price>
    </view>
    <view class="price-item" wx:if="{{orderDetail.couponDiscount > 0}}">
      <text class="price-label">优惠券</text>
      <text class="discount-text">-<s-price value="{{orderDetail.couponDiscountText}}" size="sm" color="primary" show-symbol="{{false}}"></s-price></text>
    </view>
    <view class="price-item total">
      <text class="price-label">实付金额</text>
      <s-price value="{{orderDetail.totalPriceText}}" size="lg"></s-price>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <s-button
      wx:if="{{orderDetail.status === 1}}"
      size="sm"
      variant="default"
      bindtap="onCancelOrder"
    >
      取消订单
    </s-button>
    <s-button
      wx:if="{{orderDetail.status === 3}}"
      size="sm"
      variant="default"
      bindtap="onViewLogistics"
    >
      查看物流
    </s-button>
    <s-button
      size="sm"
      variant="default"
      bindtap="onContactService"
    >
      联系客服
    </s-button>
    <s-button
      wx:if="{{orderDetail.status === 1}}"
      size="sm"
      variant="primary"
      bindtap="onPayOrder"
    >
      立即支付
    </s-button>
    <s-button
      wx:if="{{orderDetail.status === 3}}"
      size="sm"
      variant="primary"
      bindtap="onConfirmReceive"
    >
      确认收货
    </s-button>
  </view>
</view>
