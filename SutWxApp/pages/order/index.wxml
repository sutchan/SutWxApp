
<!--
文件名: index.wxml
版本号: 3.0.0
更新日期: 2026-07-06
描述: 订单列表页面模板
-->
<view class="order-container">
  <!-- 标签页 -->
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="*this"
      class="tab-item {{activeTab === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="onTabChange"
    >
      <text>{{item}}</text>
      <view wx:if="{{activeTab === index}}" class="tab-line"></view>
    </view>
  </view>

  <!-- 空状态 -->
  <s-empty-state
    wx:if="{{empty && !loading}}"
    image="/images/placeholder.svg"
    title="暂无订单"
    description="快去挑选心仪的商品吧"
  />

  <!-- 订单列表 -->
  <view wx:else class="order-list">
    <view
      wx:for="{{orderList}}"
      wx:key="id"
      class="order-item"
      bindtap="onViewDetail"
      data-id="{{item.id}}"
    >
      <!-- 订单头部 -->
      <view class="order-header">
        <text class="order-sn">订单号：{{item.orderNo}}</text>
        <text class="order-status">{{item.statusText}}</text>
      </view>

      <!-- 商品列表 -->
      <view class="order-products">
        <view
          wx:for="{{item.products}}"
          wx:for-item="product"
          wx:key="id"
          class="product-item"
        >
          <image class="product-image" src="{{product.image}}" mode="aspectFill"></image>
          <view class="product-info">
            <text class="product-name">{{product.name}}</text>
            <text class="product-spec" wx:if="{{product.spec}}">{{product.spec}}</text>
            <view class="product-bottom">
              <s-price value="{{product.priceText}}" size="sm"></s-price>
              <text class="product-quantity">x{{product.quantity}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 订单底部 -->
      <view class="order-footer">
        <view class="order-total">
          <text>共{{item.totalQuantity}}件商品 合计：</text>
          <s-price value="{{item.totalPriceText}}" size="md" color="text"></s-price>
        </view>

        <view class="order-actions">
          <s-button
            wx:if="{{item.status === 1}}"
            size="sm"
            variant="default"
            catchtap="onCancelOrder"
            data-id="{{item.id}}"
          >
            取消订单
          </s-button>
          <s-button
            wx:if="{{item.status === 1}}"
            size="sm"
            variant="primary"
            catchtap="onPayOrder"
            data-id="{{item.id}}"
          >
            立即支付
          </s-button>
          <s-button
            wx:if="{{item.status === 3}}"
            size="sm"
            variant="primary"
            catchtap="onConfirmReceive"
            data-id="{{item.id}}"
          >
            确认收货
          </s-button>
          <s-button
            wx:if="{{item.status === 4}}"
            size="sm"
            variant="default"
            catchtap="onCommentOrder"
            data-id="{{item.id}}"
          >
            评价
          </s-button>
        </view>
      </view>
    </view>
  </view>
</view>
