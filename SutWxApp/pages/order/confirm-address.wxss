/* 收货地址 */
.address-section {
  background-color: var(--background-primary);
  padding: 30rpx;
}

.address-info {
  display: flex;
  flex-direction: column;
}

.name-phone {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.name-phone text {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.address-detail {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.address-empty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--text-secondary);
  font-size: 28rpx;
}

.arrow {
  font-size: 32rpx;
  color: var(--text-tertiary);
}
