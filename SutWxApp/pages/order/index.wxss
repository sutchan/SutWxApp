
/**
 * 文件名: pages/order/index.wxss
 * 版本号: 3.1.1
 * 更新日期: 2026-09-13
 * 描述: 订单列表页面样式，对齐 design/spec.md v3.1.1
 */

.order-container {
  min-height: 100vh;
  background-color: var(--background-secondary);
}

/* 标签页 */
.tabs {
  display: flex;
  background-color: var(--background-primary);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: 500;
}

.tab-line {
  position: absolute;
  bottom: 0;
  width: 60rpx;
  height: 4rpx;
  background-color: var(--primary-color);
  border-radius: 2rpx;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 订单列表 */
.order-list {
  padding: 20rpx;
}

.order-item {
  background-color: var(--background-primary);
  border-radius: var(--border-radius-lg);
  margin-bottom: 20rpx;
  overflow: hidden;
}

/* 订单头部 */
.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.order-sn {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.order-status {
  font-size: 26rpx;
  color: var(--primary-color);
}

/* 商品列表 */
.order-products {
  padding: 24rpx;
}

.product-item {
  display: flex;
  margin-bottom: 20rpx;
}

.product-item:last-child {
  margin-bottom: 0;
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--border-radius-md);
  margin-right: 20rpx;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-spec {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-price {
  font-size: 30rpx;
  color: var(--primary-dark);
  font-weight: bold;
}

.product-quantity {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 订单底部 */
.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-top: 1rpx solid var(--border-color);
}

.order-total {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.order-total .price {
  font-size: 32rpx;
  color: var(--primary-dark);
  font-weight: bold;
}

.order-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  border-radius: 30rpx;
  border: none;
}

.cancel-btn {
  background-color: var(--background-tertiary);
  color: var(--text-secondary);
}

.pay-btn,
.confirm-btn,
.comment-btn {
  background-color: var(--primary-color);
  color: var(--text-inverse);
}
