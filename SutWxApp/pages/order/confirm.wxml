<!--
文件名: confirm.wxml
版本号: 2.1.0
更新日期: 2026-06-09
描述: 订单确认页面模板
--><view class="confirm-container">
  <!-- 收货地址 -->
  <view class="address-section" bindtap="onSelectAddress">
    <view wx:if="{{address}}" class="address-info">
      <view class="name-phone">
        <text>{{address.name}}</text>
        <text>{{address.phone}}</text>
      </view>
      <text class="address-detail">{{address.detail}}</text>
    </view>
    <view wx:else class="address-empty">
      <text>请选择收货地址</text>
      <text class="arrow">></text>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="products-section">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="product-item"
    >
      <image class="product-image" src="{{item.image}}" mode="aspectFill"></image>
      <view class="product-info">
        <text class="product-name">{{item.name}}</text>
        <text class="product-spec" wx:if="{{item.spec}}">{{item.spec}}</text>
        <view class="product-bottom">
          <text class="product-price">{{item.priceText}}</text>
          <text class="product-quantity">{{item.quantityText}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="remark-section">
    <text class="remark-label">订单备注</text>
    <input
      class="remark-input"
      placeholder="选填，请先和商家协商一致"
      value="{{remark}}"
      bindinput="onRemarkInput"
      maxlength="100"
    />
  </view>

  <!-- 价格明细 -->
  <view class="price-section">
    <view class="price-item">
      <text class="price-label">商品金额</text>
      <text class="price-value">{{totalPriceText}}</text>
    </view>
    <view class="price-item">
      <text class="price-label">运费</text>
      <text class="price-value">{{shippingFeeText}}</text>
    </view>
    <view class="price-item" wx:if="{{couponDiscount > 0}}">
      <text class="price-label">优惠券</text>
      <text class="price-value discount">-{{couponDiscountText}}</text>
    </view>
  </view>

  <!-- 底部栏 -->
  <view class="bottom-bar">
    <view class="total-box">
      <text class="total-label">合计：</text>
      <text class="total-price">{{finalPriceText}}</text>
    </view>
    <button
      class="submit-btn"
      bindtap="onSubmitOrder"
      disabled="{{submitting}}"
    >
      {{submitting ? '提交中...' : '提交订单'}}
    </button>
  </view>
</view>
