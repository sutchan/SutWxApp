
<!--
文件名: confirm.wxml
版本号: 3.0.0
更新日期: 2026-07-06
描述: 订单确认页面模板
-->
<view class="confirm-container">
  <!-- 收货地址 -->
  <view class="address-section" bindtap="onSelectAddress">
    <view wx:if="{{address}}" class="address-info">
      <view class="name-phone">
        <text>{{address.name}}</text>
        <text>{{address.phone}}</text>
      </view>
      <text class="address-detail">{{address.detail}}</text>
    </view>
    <view wx:else class="address-empty">
      <text>请选择收货地址</text>
      <text class="arrow">></text>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="products-section">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="product-item"
    >
      <image class="product-image" src="{{item.image}}" mode="aspectFill"></image>
      <view class="product-info">
        <text class="product-name">{{item.name}}</text>
        <text class="product-spec" wx:if="{{item.spec}}">{{item.spec}}</text>
        <view class="product-bottom">
          <s-price value="{{item.priceText}}" size="sm"></s-price>
          <text class="product-quantity">x{{item.quantity}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="remark-section">
    <text class="remark-label">订单备注</text>
    <input
      class="remark-input"
      placeholder="选填，请先和商家协商一致"
      value="{{remark}}"
      bindinput="onRemarkInput"
      maxlength="100"
    />
  </view>

  <!-- 价格明细 -->
  <view class="price-section">
    <view class="price-item">
      <text class="price-label">商品金额</text>
      <s-price value="{{totalPriceText}}" size="sm" color="text"></s-price>
    </view>
    <view class="price-item">
      <text class="price-label">运费</text>
      <text wx:if="{{shippingFee === 0}}" class="shipping-free">免运费</text>
      <s-price wx:else value="{{shippingFeeText}}" size="sm" color="text"></s-price>
    </view>
    <view class="price-item" wx:if="{{couponDiscount > 0}}">
      <text class="price-label">优惠券</text>
      <text class="discount-text">-<s-price value="{{couponDiscountText}}" size="sm" color="primary" show-symbol="{{false}}"></s-price></text>
    </view>
  </view>

  <!-- 底部栏 -->
  <view class="bottom-bar">
    <view class="total-box">
      <text class="total-label">合计：</text>
      <s-price value="{{finalPriceText}}" size="lg"></s-price>
    </view>
    <s-button
      variant="primary"
      bindtap="onSubmitOrder"
      loading="{{submitting}}"
      class="submit-btn"
    >
      {{submitting ? '提交中' : '提交订单'}}
    </s-button>
  </view>
</view>
