
/**
 * 文件名: pages/order/confirm.wxss
 * 版本号: 3.1.1
 * 更新日期: 2026-09-13
 * 描述: 订单确认页面样式，对齐 design/spec.md v3.1.1 品牌绿策略
 */

.confirm-container {
  min-height: 100vh;
  background-color: var(--background-secondary);
  padding-bottom: 120rpx;
}

/* 收货地址 */
.address-section {
  background-color: var(--background-primary);
  padding: 30rpx;
}

.address-info {
  display: flex;
  flex-direction: column;
}

.name-phone {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.name-phone text {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.address-detail {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.address-empty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--text-secondary);
  font-size: 28rpx;
}

.arrow {
  font-size: 32rpx;
  color: var(--text-tertiary);
}

/* 商品列表 */
.products-section {
  background-color: var(--background-primary);
  margin-top: 20rpx;
  padding: 24rpx;
}

.product-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.product-item:last-child {
  border-bottom: none;
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--border-radius-md);
  margin-right: 20rpx;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-spec {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-price {
  font-size: 30rpx;
  color: var(--primary-dark);
  font-weight: bold;
}

.product-quantity {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 备注 */
.remark-section {
  background-color: var(--background-primary);
  margin-top: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
}

.remark-label {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-right: 20rpx;
}

.remark-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
}

/* 价格明细 */
.price-section {
  background-color: var(--background-primary);
  margin-top: 20rpx;
  padding: 24rpx;
}

.price-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.price-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.price-value {
  font-size: 26rpx;
  color: var(--text-primary);
}

.price-value.discount {
  color: var(--primary-dark);
}

/* 底部栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: var(--background-primary);
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.total-box {
  display: flex;
  align-items: center;
}

.total-label {
  font-size: 26rpx;
  color: var(--text-primary);
}

.total-price {
  font-size: 36rpx;
  color: var(--primary-dark);
  font-weight: bold;
  margin-left: 10rpx;
}

.submit-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  background-color: var(--primary-color);
  color: var(--text-inverse);
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 0;
  border: none;
  transition: opacity var(--transition-fast);
}

.submit-btn:active {
  opacity: 0.85;
}

.submit-btn[disabled] {
  background-color: var(--text-tertiary);
}
