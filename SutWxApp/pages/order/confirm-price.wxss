/* 价格明细 */
.price-section {
  background-color: var(--background-primary);
  margin-top: 20rpx;
  padding: 24rpx;
}

.price-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.price-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.price-value {
  font-size: 26rpx;
  color: var(--text-primary);
}

.price-value.discount {
  color: var(--primary-dark);
}
